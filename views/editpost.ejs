<%- (include("partials/header")) %>

<form action="/post/<%= post.slug %>/edit" method="POST">
    <div class="container">
        <div class="form-card">
            <h1>Edit Post</h1>
            
            <div class="form-group">
                <label for="title">Title</label>
                <input name="title" type="text" id="title" value= <%= post.title %>>
                <label for="content">Content</label>
                <textarea name="content" id="content" placeholder = "Enter post content"> <%= post.content %></textarea>
                    <button type="submit" class="btn">Edit post</button>
            </div>
        </div>
    </div>
</form>


<%- (include("partials/footer")) %>